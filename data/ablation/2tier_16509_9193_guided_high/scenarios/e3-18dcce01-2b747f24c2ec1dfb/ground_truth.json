  "resolved_asset_bindings": {
    "customer-records": {
      "asset_id": "customer-records",
      "node_ref": "data-store",
      "variant_id": "postgresql",
      "service_family": "postgresql",
      "service_role": "database",
      "service_access": {
        "protocol": "postgres",
