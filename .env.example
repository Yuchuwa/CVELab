# ContainerLab Builder 配置文件示例
# 复制此文件为 .env 并填写你的配置

# ===================
# LLM 配置（必需）
# ===================
# LLM API 密钥（必需）
LLM_API_KEY="your_api_key_here"

# LLM API 基础 URL（可选）
# 对于 OpenAI: https://api.openai.com/v1
# 对于 DeepSeek: https://api.deepseek.com/v1
LLM_BASE_URL="https://api.deepseek.com/v1"

# LLM 模型名称（可选，默认：DeepSeek-V3.2）
# 常用选项: gpt-4o, gpt-4-turbo, DeepSeek-V3.2, claude-3-5-sonnet-20241022
LLM_MODEL="DeepSeek-V3.2"

# ===================
# 工作流配置
# ===================
# 最大重试次数（默认：3，范围：1-10）
MAX_RETRIES=3

# 操作超时时间（秒，默认：600，范围：60-3600）
TIMEOUT_SECONDS=600

# ===================
# 容器健康检查配置
# ===================
# 容器健康检查间隔（秒，默认：3，范围：1-30）
CONTAINER_HEALTH_CHECK_INTERVAL=3

# 容器健康检查最大重试次数（默认：10，范围：1-60）
CONTAINER_HEALTH_CHECK_MAX_RETRIES=10

# ===================
# 日志配置
# ===================
# 日志级别（默认：INFO）
# 可选值: DEBUG, INFO, WARNING, ERROR, CRITICAL
# DEBUG - 详细的调试信息，包括所有命令输出
# INFO - 一般信息，包括进度和状态
# WARNING - 警告信息
# ERROR - 仅错误信息
LOG_LEVEL="INFO"

# 是否记录日志到文件（默认：true）
# 日志文件将保存在 clab_out/<session_id>/<session_id>.log
LOG_TO_FILE=true
#langsmith 配置
LANGSMITH_TRACING=true
LANGSMITH_API_KEY="your_langsmith_api_key_here"
LANGSMITH_PROJECT="ContainerLab Builder"